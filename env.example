# Railway / server environment
# PORT is provided by Railway automatically. Do not hardcode it on Railway.
# PORT=8788

# Admin panel password (required)
ADMIN_PASSWORD=change-me

# Site
SITE_NAME=Habiba teacher
APP_URL=https://habibateacher.uz

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
TELEGRAM_URL=
CONTACT_PHONE=

# Uploads (MB)
MAX_UPLOAD_MB=100

# Storage (Railway volume). If a volume is mounted at /data, the app uses:
# DATA_DIR=/data/data
# STORAGE_DIR=/data/storage
# RAILWAY_VOLUME_MOUNT_PATH is set automatically by Railway.
